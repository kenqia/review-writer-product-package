{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/evidence/parse_quality_gate.v1.schema.json",
  "title": "Object-level parse quality gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "bundle_digest",
    "objects",
    "gate_digest",
    "status",
    "workflow_can_continue",
    "automatic_extraction_allowed"
  ],
  "properties": {
    "schema_version": {"const": "parse-quality-gate.v1"},
    "study_id": {"type": "string", "minLength": 1},
    "bundle_digest": {"$ref": "#/$defs/sha256"},
    "prior_gate_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/object"}},
    "gate_digest": {"$ref": "#/$defs/sha256"},
    "status": {
      "enum": ["needs_review", "approved", "approved_with_pdf_locator", "blocked", "stale"]
    },
    "workflow_can_continue": {"type": "boolean"},
    "automatic_extraction_allowed": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "page"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "note", "decided_at", "bound_gate_digest"],
      "properties": {
        "schema_version": {"const": "verification-decision.v1"},
        "actor_type": {
          "enum": ["human_researcher", "simulated_researcher_agent"]
        },
        "actor_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "action": {
          "enum": ["approve_candidate_extraction", "pdf_locator_only", "reparse_required"]
        },
        "note": {"type": "string", "minLength": 1, "maxLength": 2000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "decided_at": {"type": "string", "minLength": 1},
        "bound_gate_digest": {"$ref": "#/$defs/sha256"},
        "bound_object_digest": {"$ref": "#/$defs/sha256"},
        "pdf_resolution": {"$ref": "#/$defs/pdf_resolution"}
      }
    },
    "pdf_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "source_scope",
        "limitations",
        "source_pdf_sha256"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "source_scope": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limitations": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "source_id",
        "kind",
        "status",
        "issues",
        "decision"
      ],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "object_digest": {"$ref": "#/$defs/sha256"},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "source_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "body_order",
            "section_boundaries",
            "figure_caption_links",
            "table_structure",
            "formula_chemistry",
            "reference_boundary",
            "supplement_completeness"
          ]
        },
        "status": {"enum": ["usable", "usable_with_review", "incomplete", "failed"]},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]},
        "prior_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        },
        "review_state": {
          "enum": ["not_required", "needs_review", "needs_re_review", "decided"]
        },
        "re_review_reason": {
          "enum": [null, "reparse_completed", "reparse_completed_object_changed", "object_changed"]
        }
      }
    }
  }
}
