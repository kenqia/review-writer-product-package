{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/evidence/source_truth_bundle.v1.schema.json",
  "title": "Per-study source truth bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "study_id",
    "study_identity",
    "sources",
    "warnings",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": "source-truth-bundle.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "study_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi", "title"],
      "properties": {
        "doi": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bundle_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/portable_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "document_role",
        "source_type",
        "mineru_slug",
        "pdf",
        "canonical_markdown",
        "content_list",
        "content_list_v2",
        "layout",
        "reading_layer",
        "layout_layer",
        "page_count",
        "images"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "document_role": {"enum": ["MAIN", "SI"]},
        "source_type": {"const": "primary_study"},
        "mineru_slug": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "pdf": {"$ref": "#/$defs/file"},
        "canonical_markdown": {"$ref": "#/$defs/file"},
        "content_list": {"$ref": "#/$defs/file"},
        "content_list_v2": {"$ref": "#/$defs/file"},
        "layout": {"$ref": "#/$defs/file"},
        "reading_layer": {"$ref": "#/$defs/file"},
        "layout_layer": {"$ref": "#/$defs/file"},
        "page_count": {"type": "integer", "minimum": 1},
        "images": {"$ref": "#/$defs/images"}
      }
    }
  }
}
