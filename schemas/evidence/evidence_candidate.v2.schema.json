{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/evidence/evidence_candidate.v2.schema.json",
  "title": "Grounded single-study evidence candidate v2",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "study_id",
    "eligibility",
    "study_card",
    "anchor_reaction_unit_id",
    "reaction_units",
    "claims",
    "conflicts",
    "r3_review_items",
    "source_coverage",
    "extraction_limitations",
    "self_check"
  ],
  "properties": {
    "schema_version": {"const": "evidence-candidate.v2"},
    "job_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "doi": {"type": ["string", "null"]},
    "eligibility": {
      "type": "object",
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {
          "enum": [
            "SCIENTIFICALLY_ELIGIBLE_CORE",
            "NON_CORE_COMPARATOR",
            "EXCLUDE_SCIENTIFIC",
            "ELIGIBILITY_UNRESOLVED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "additionalProperties": true
    },
    "study_card": {"type": "object"},
    "anchor_reaction_unit_id": {"type": "string", "minLength": 1},
    "reaction_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/grounded_reaction_unit"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/grounded_claim"}
    },
    "conflicts": {"type": "array"},
    "r3_review_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/r3_review_item"}
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/source_coverage_entry"}
    },
    "extraction_limitations": {"type": "array"},
    "self_check": {
      "type": "object",
      "description": "Model-authored diagnostics only; deterministic validation never trusts this field."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "risk_level": {"enum": ["R0", "R1", "R2", "R3"]},
    "risk_category": {
      "enum": [
        "STRUCTURE",
        "STEREOCHEMISTRY",
        "MECHANISM_CAUSALITY",
        "NEGATIVE_GENERALIZATION",
        "MATERIAL_COMPARISON",
        "FIGURE_TABLE_CHEMISTRY"
      ]
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "evidence_mode",
        "source_id",
        "page",
        "section_or_item",
        "exact_quote",
        "evidence_summary",
        "depiction_locator",
        "transcribed_values",
        "r3_flags"
      ],
      "properties": {
        "evidence_mode": {
          "enum": ["TEXT_QUOTE", "FIGURE_TABLE_IMAGE", "LOCATOR_UNRESOLVED"]
        },
        "source_id": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section_or_item": {"type": "string", "minLength": 1},
        "exact_quote": {"type": ["string", "null"]},
        "evidence_summary": {"type": "string", "minLength": 1},
        "depiction_locator": {"type": ["string", "null"]},
        "transcribed_values": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "r3_flags": {
          "type": "array",
          "items": {"const": "R3_SOURCE_DEPICTION_REQUIRED"},
          "uniqueItems": true
        },
        "unresolved_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"properties": {"evidence_mode": {"const": "TEXT_QUOTE"}}},
          "then": {
            "properties": {
              "page": {"type": "integer", "minimum": 1},
              "exact_quote": {"type": "string", "minLength": 1},
              "depiction_locator": {"type": "null"},
              "transcribed_values": {"maxItems": 0},
              "r3_flags": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"evidence_mode": {"const": "FIGURE_TABLE_IMAGE"}}},
          "then": {
            "properties": {
              "page": {"type": "integer", "minimum": 1},
              "exact_quote": {"type": "null"},
              "depiction_locator": {"type": "string", "minLength": 1},
              "transcribed_values": {"minItems": 1},
              "r3_flags": {"contains": {"const": "R3_SOURCE_DEPICTION_REQUIRED"}}
            }
          }
        },
        {
          "if": {"properties": {"evidence_mode": {"const": "LOCATOR_UNRESOLVED"}}},
          "then": {
            "required": ["unresolved_reason"],
            "properties": {
              "exact_quote": {"type": "null"}
            }
          }
        }
      ]
    },
    "grounded_reaction_unit": {
      "type": "object",
      "required": [
        "reaction_unit_id",
        "risk_level",
        "risk_categories",
        "evidence_refs"
      ],
      "properties": {
        "reaction_unit_id": {"type": "string", "minLength": 1},
        "risk_level": {"$ref": "#/$defs/risk_level"},
        "risk_categories": {
          "type": "array",
          "items": {"$ref": "#/$defs/risk_category"},
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "additionalProperties": true
    },
    "grounded_claim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_text",
        "risk_level",
        "risk_categories",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_text": {"type": "string", "minLength": 1},
        "risk_level": {"$ref": "#/$defs/risk_level"},
        "risk_categories": {
          "type": "array",
          "items": {"$ref": "#/$defs/risk_category"},
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "additionalProperties": true
    },
    "r3_review_item": {
      "type": "object",
      "required": ["target_id", "risk_categories", "action_required"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "risk_categories": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/risk_category"},
          "uniqueItems": true
        },
        "action_required": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "source_coverage_entry": {
      "type": "object",
      "required": ["status", "evidence_ref_count", "note"],
      "properties": {
        "status": {
          "enum": ["READ_AND_USED", "READ_NO_RELEVANT_EVIDENCE", "READ_FAILED"]
        },
        "evidence_ref_count": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
