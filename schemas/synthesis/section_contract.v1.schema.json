{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/synthesis/section_contract.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "section_id", "research_question", "comparison_axes", "expected_synthesis", "counterevidence_and_limitations", "evidence_budget", "synthesis_budget", "figure_plan", "allowed_wording_strength", "synthesis_projection_digest", "decision", "contract_digest"],
  "properties": {
    "schema_version": {"const": "section-contract.v1"}, "section_id": {"type": "string", "minLength": 1}, "research_question": {"type": "string", "minLength": 1}, "comparison_axes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "expected_synthesis": {"type": "string", "minLength": 1}, "counterevidence_and_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_budget": {"type": "integer", "minimum": 1}, "synthesis_budget": {"type": "integer", "minimum": 1}, "figure_plan": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "allowed_wording_strength": {"type": "string", "minLength": 1}, "synthesis_projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"type": ["object", "null"]}, "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
