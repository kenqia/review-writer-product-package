{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/figures/synthesis_figure_placeholder.v1.schema.json",
  "title": "Synthesis figure placeholder v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["placeholder_id", "scientific_question", "reader_takeaway", "panels", "comparison_axis", "required_labels_units", "counter_evidence", "forbidden_overclaims", "unresolved_uncertainties", "caption_draft", "target_size", "status"],
  "properties": {
    "placeholder_id": {"type": "string", "minLength": 1},
    "scientific_question": {"type": "string", "minLength": 1},
    "reader_takeaway": {"type": "string", "minLength": 1},
    "panels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["panel", "task", "synthesis_claim_ids", "source_figure_ids"],
        "properties": {
          "panel": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "synthesis_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_figure_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "comparison_axis": {"type": "string", "minLength": 1},
    "required_labels_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counter_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_overclaims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_uncertainties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "caption_draft": {"type": "string", "minLength": 1},
    "target_size": {"type": "string", "minLength": 1},
    "status": {"enum": ["awaiting_human_figure", "uploaded", "verified"]}
  }
}
