{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/figures/source_figure.v1.schema.json",
  "title": "Source Figure registry entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["figure_id", "study_id", "source_id", "page", "figure_label", "caption", "asset_path", "asset_sha256", "source_pdf_sha256", "evidence_ids", "selection_status", "fragments"],
  "properties": {
    "figure_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "page": {"type": "integer", "minimum": 1},
    "figure_label": {"type": "string", "minLength": 1},
    "caption": {"type": "string", "minLength": 1},
    "asset_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chemical_paper_import_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selection_status": {"enum": ["selected", "available", "rejected"]},
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure_id", "asset_sha256", "manuscript_sha256", "section_id", "marker", "occurrence"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manuscript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "section_id": {"type": "string", "minLength": 1},
        "marker": {"type": "string", "pattern": "^(?:\\[(?:source|evidence):[A-Za-z0-9._:-]+\\]|<!--\\s*(?:source|evidence)\\s*:[A-Za-z0-9._:-]+\\s*-->)$"},
        "occurrence": {"type": "integer", "minimum": 1}
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "block_index", "bbox", "asset_path", "asset_sha256", "caption_association"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "block_index": {"type": "integer", "minimum": 0},
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0}
          },
          "asset_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
          "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "caption_association": {"enum": ["explicit_caption_anchor", "same_page_spatial_group"]}
        }
      }
    },
    "selection_reason": {"type": "string", "minLength": 1},
    "rights_status": {"enum": ["unknown", "cleared"]},
    "rights_license": {"type": "string", "minLength": 1},
    "rights_evidence_reference": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"rights_status": {"const": "cleared"}}, "required": ["rights_status"]},
      "then": {"required": ["rights_license"]}
    }
  ]
}
