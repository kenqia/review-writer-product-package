{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-writer.local/schemas/delivery/release_snapshot.v1.schema.json",
  "title": "Evidence-to-release snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "route", "release_level", "status",
    "workflow_digest", "lineage_digest", "manuscript_sha256", "release_markdown_sha256",
    "chemical_paper_binding_digest", "chemical_paper_safe_summary",
    "chemical_paper_dependency_can_release", "markdown_path",
    "docx_path", "docx_sha256", "placeholder_count", "pending_placeholder_count",
    "hard_fail_signals", "system_generated_synthesis_figure", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "release-snapshot.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "route": {"enum": ["evidence-to-release.v1", "honest_progressive"]},
    "release_level": {"enum": ["SELF_REVIEWED_DRAFT", "EXPERT_REVIEWED_RELEASE"]},
    "status": {"enum": ["SELF_REVIEWED_DRAFT", "EXPERT_REVIEWED_RELEASE"]},
    "workflow_digest": {"$ref": "#/$defs/sha256"},
    "lineage_digest": {"$ref": "#/$defs/sha256"},
    "manuscript_sha256": {"$ref": "#/$defs/sha256"},
    "release_markdown_sha256": {"$ref": "#/$defs/sha256"},
    "chemical_paper_binding_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "chemical_paper_safe_summary": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/chemical_paper_safe_summary"}]
    },
    "chemical_paper_dependency_can_release": {"type": "boolean"},
    "credits_status": {"const": "NOT_APPLICABLE_BY_CURRENT_SCOPE"},
    "core_molecule_count": {"type": "integer", "minimum": 0},
    "confirmed_count": {"type": "integer", "minimum": 0},
    "ai_provisional_count": {"type": "integer", "minimum": 0},
    "blocked_count": {"type": "integer", "minimum": 0},
    "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage_threshold": {"const": 0.8},
    "coverage_sufficient": {"type": "boolean"},
    "paper_coverage": {"type": "array", "items": {"type": "object"}},
    "uncertainty_statement": {"type": "string", "minLength": 1},
    "gap_registry": {"type": "array", "items": {"type": "object"}},
    "traceability": {"type": "array", "items": {"type": "object"}},
    "actor_provenance_residual": {
      "type": "array",
      "items": {"$ref": "#/$defs/actor_provenance_residual"}
    },
    "markdown_path": {"pattern": "^05_release/(?:self_reviewed_draft|expert_reviewed_release)\\.md$"},
    "docx_path": {"pattern": "^05_release/(?:self_reviewed_draft|expert_reviewed_release)\\.docx$"},
    "docx_sha256": {"$ref": "#/$defs/sha256"},
    "placeholder_count": {"type": "integer", "minimum": 0},
    "pending_placeholder_count": {"type": "integer", "minimum": 0},
    "hard_fail_signals": {"type": "array", "items": {"type": "string"}},
    "system_generated_synthesis_figure": {"const": false},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"route": {"const": "honest_progressive"}},
        "required": ["route"]
      },
      "then": {
        "required": [
          "credits_status", "core_molecule_count", "confirmed_count",
          "ai_provisional_count", "blocked_count", "coverage_ratio",
          "coverage_threshold", "coverage_sufficient", "paper_coverage",
          "uncertainty_statement", "gap_registry", "traceability",
          "actor_provenance_residual"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_provenance_residual": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "actor_type": {"type": "string", "minLength": 1},
        "actor_label": {"type": "string", "minLength": 1},
        "expected_actor_type": {"type": "string", "minLength": 1},
        "observed_actor_type": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1}
      }
    },
    "chemical_paper_safe_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "route", "study_count", "molecule_count",
        "missing_name_count", "missing_resolved_smiles_count",
        "ai_authored_smiles_count", "element_review_counts", "reaction_data_status"
      ],
      "properties": {
        "schema_version": {"const": "chemical-paper-safe-summary.v2"},
        "route": {"const": "chemical-paper-zip-only"},
        "study_count": {"type": "integer", "minimum": 1},
        "molecule_count": {"type": "integer", "minimum": 0},
        "missing_name_count": {"type": "integer", "minimum": 0},
        "missing_resolved_smiles_count": {"type": "integer", "minimum": 0},
        "ai_authored_smiles_count": {"type": "integer", "minimum": 0},
        "element_review_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["not_reviewed", "confirmed", "corrected", "not_applicable"],
          "properties": {
            "not_reviewed": {"type": "integer", "minimum": 0},
            "confirmed": {"type": "integer", "minimum": 0},
            "corrected": {"type": "integer", "minimum": 0},
            "not_applicable": {"type": "integer", "minimum": 0}
          }
        },
        "reaction_data_status": {"enum": ["available", "unavailable_not_provided"]}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "zip_valid", "relationships_valid", "document_xml_sha256",
        "media_sha256", "markdown_roundtrip_match", "attribution_complete",
        "workflow_digest_match", "provenance_valid", "document_xml_changed", "media_changed",
        "legacy_repackage_only"
      ],
      "properties": {
        "schema_version": {"const": "docx-integrity.v1"},
        "zip_valid": {"const": true},
        "relationships_valid": {"const": true},
        "document_xml_sha256": {"$ref": "#/$defs/sha256"},
        "media_sha256": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "markdown_roundtrip_match": {"const": true},
        "attribution_complete": {"const": true},
        "workflow_digest_match": {"const": true},
        "provenance_valid": {"const": true},
        "document_xml_changed": {"type": ["boolean", "null"]},
        "media_changed": {"type": ["boolean", "null"]},
        "legacy_repackage_only": {"const": false}
      }
    }
  }
}
